# NextAuth
NEXTAUTH_SECRET=please-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# SQLite database file path (생성될 위치)
DATABASE_URL=./data/jummechu.db

# 네이버 지도 (M6) — JS SDK Client ID
# 발급: https://console.ncloud.com → 콘솔 → AI·Application Service → Maps
# 도메인 제한 필수
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
